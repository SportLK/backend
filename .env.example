# SportLK Backend Environment Variables
PORT=3000
NODE_ENV=development

# Database (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=your_mysql_password
DB_NAME=sportlk_db
DB_SYNCHRONIZE=true
DB_LOGGING=true

# JWT Secrets
JWT_SECRET=supersecret_jwt_key_sportlk_2026
JWT_EXPIRES_IN=7d

# PayHere Configuration (Sandbox)
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
PAYHERE_CURRENCY=LKR

# Cloudinary (Media storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
