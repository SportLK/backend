NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:3001,http://localhost:8081

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=sportlk

# Generate separate random values of at least 32 characters for deployed environments.
JWT_ACCESS_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-random-secret-at-least-32-characters

# Optional bootstrap account for the first admin.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=SportLK Admin
