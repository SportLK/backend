NODE_ENV=development
PORT=3000

# Local MySQL connection. Use the host and credentials for your own database.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=sportlk_db
DB_SSL=false

# TypeORM creates/updates the local schema in development. Keep this false in production.
DB_SYNCHRONIZE=true

# Replace both values before deploying. Keep them separate and at least 32 characters.
JWT_ACCESS_SECRET=local-dev-access-secret-change-before-deploy-000000
JWT_REFRESH_SECRET=local-dev-refresh-secret-change-before-deploy-000000

# Optional: set these once to create the first admin account on backend startup.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=SportLK Admin
